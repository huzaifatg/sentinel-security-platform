# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://sentinel-security-platform-9kuj.onrender.com

# Planned backend configuration
# Neon pooled URL is accepted as postgresql://...; the backend normalizes it for psycopg 3.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/sentinel?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
